#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors/eyelash_dfu.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime_tapdance.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "Numpad";
            bindings = <
                &kp KP_N7      &kp KP_N8 &kp KP_N9  &kp KP_DIVIDE
                &kp KP_N4      &kp KP_N5 &kp KP_N6  &kp KP_MULTIPLY
                &kp KP_N1      &kp KP_N2 &kp KP_N3  &kp KP_MINUS
                &lt 1 KP_ENTER &kp KP_N0 &kp KP_DOT &kp KP_PLUS
            >;
        };
        function_layer {
            display-name = "Fn";
            bindings = <
                &kp KP_NUMLOCK &kp KP_ENTER &kp DELETE     &kp BACKSPACE
                &kp C_MUTE     &kp C_VOL_UP &kp C_VOL_DN   &none
                &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2   &none
                &trans         &none       &studio_unlock &eyelash_dfu
            >;
        };
        user_layer_1 {
            display-name = "Custom 1";
            bindings = <
                &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans
            >;
        };
        user_layer_2 {
            display-name = "Custom 2";
            bindings = <
                &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans
            >;
        };
    };
};
