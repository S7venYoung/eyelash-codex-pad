/dts-v1/;
#include <nordic/nrf52832_qfaa.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    model = "Eyelash Numpad";
    compatible = "eyelash,numpad";
    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,kscan = &kscan0;
        zmk,battery = &vbatt;
        zmk,physical-layout = &numpad_layout;
        zephyr,code-partition = &code_partition;
    };
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios = <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        col-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>,
                    <&gpio0 7 GPIO_ACTIVE_HIGH>,
                    <&gpio0 9 GPIO_ACTIVE_HIGH>,
                    <&gpio0 25 GPIO_ACTIVE_HIGH>;
    };
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
        >;
    };
    numpad_layout: numpad_layout {
        compatible = "zmk,physical-layout";
        display-name = "Eyelash Numpad 16 keys";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys = <&key_physical_attrs 100 100   0   0 0 0 0>,
               <&key_physical_attrs 100 100 100   0 0 0 0>,
               <&key_physical_attrs 100 100 200   0 0 0 0>,
               <&key_physical_attrs 100 100 300   0 0 0 0>,
               <&key_physical_attrs 100 100   0 100 0 0 0>,
               <&key_physical_attrs 100 100 100 100 0 0 0>,
               <&key_physical_attrs 100 100 200 100 0 0 0>,
               <&key_physical_attrs 100 100 300 100 0 0 0>,
               <&key_physical_attrs 100 100   0 200 0 0 0>,
               <&key_physical_attrs 100 100 100 200 0 0 0>,
               <&key_physical_attrs 100 100 200 200 0 0 0>,
               <&key_physical_attrs 100 100 300 200 0 0 0>,
               <&key_physical_attrs 100 100   0 300 0 0 0>,
               <&key_physical_attrs 100 100 100 300 0 0 0>,
               <&key_physical_attrs 100 100 200 300 0 0 0>,
               <&key_physical_attrs 100 100 300 300 0 0 0>;
    };
    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 0>;
        output-ohms = <2000000>;
        full-ohms = <2806000>;
    };
};
&adc { status = "okay"; };
&gpiote { status = "okay"; };
&gpio0 { status = "okay"; };

/* The bootloader uses S132 only during DFU; ZMK uses Zephyr's BLE stack. */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        sd_partition: partition@0 {
            label = "mbr-softdevice";
            reg = <0x00000000 0x00026000>;
        };
        code_partition: partition@26000 {
            label = "code";
            reg = <0x00026000 0x00047000>;
        };
        storage_partition: partition@6d000 {
            label = "storage";
            reg = <0x0006d000 0x00007000>;
        };
        boot_partition: partition@74000 {
            label = "bootloader";
            reg = <0x00074000 0x0000a000>;
        };
        mbr_params_partition: partition@7e000 {
            label = "mbr-params";
            reg = <0x0007e000 0x00001000>;
        };
        boot_settings_partition: partition@7f000 {
            label = "bootloader-settings";
            reg = <0x0007f000 0x00001000>;
        };
    };
};

